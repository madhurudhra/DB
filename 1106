class Worker:

    async def _si_collect_batch_quotes_v1(self, symbols):
        """Sequential schema-bounded batches; no order calls or concurrency."""
        requested = sorted(set(symbols))
        quotes, scores, failures = {}, {}, {}
        observed_at = {}
        venue_times = {}
        if not requested:
            return quotes, scores, failures

        # Discover the request bound instead of assuming a batch size.
        listing = await self.broker.session.list_tools()
        if hasattr(listing, "model_dump"):
            listing = listing.model_dump(mode="json", by_alias=True)
        if not isinstance(listing, dict):
            raise Blocked("QUOTE_TOOL_METADATA_INVALID")
        tools = [
            tool for tool in listing.get("tools", [])
            if isinstance(tool, dict)
            and tool.get("name") == "get_equity_quotes"
        ]
        if len(tools) != 1:
            raise Blocked("QUOTE_TOOL_METADATA_NOT_UNIQUE")

        schema = tools[0].get(
            "inputSchema", tools[0].get("input_schema")
        )
        if not isinstance(schema, dict):
            raise Blocked("QUOTE_TOOL_SCHEMA_MISSING")
        properties = schema.get("properties")
        if not isinstance(properties, dict):
            raise Blocked("QUOTE_TOOL_PROPERTIES_MISSING")
        symbol_schema = properties.get("symbols")
        if not isinstance(symbol_schema, dict):
            raise Blocked("QUOTE_TOOL_SYMBOLS_SCHEMA_MISSING")

        # Some schemas wrap nullable arrays in anyOf/oneOf.
        variants = [symbol_schema]
        variants += symbol_schema.get("anyOf", [])
        variants += symbol_schema.get("oneOf", [])
        arrays = [
            item for item in variants
            if isinstance(item, dict)
            and (
                item.get("type") == "array"
                or isinstance(item.get("type"), list)
                and "array" in item["type"]
            )
        ]
        if len(arrays) != 1:
            raise Blocked("QUOTE_TOOL_ARRAY_SCHEMA_AMBIGUOUS")

        maximum = arrays[0].get("maxItems")
        if maximum is None:
            batch_size = min(100, len(requested))
        elif type(maximum) is int and maximum >= 1:
            batch_size = min(maximum, 100)
        else:
            raise Blocked("QUOTE_TOOL_BATCH_LIMIT_INVALID")

        for offset in range(0, len(requested), batch_size):
            batch = requested[offset:offset + batch_size]
            try:
                data = await self.broker.call(
                    "get_equity_quotes", {"symbols": batch}
                )
                rows = data.get("results")
                if not isinstance(rows, list):
                    raise Blocked("BATCH_QUOTE_RESULTS_INVALID")

                by_symbol = {}
                for row in rows:
                    if not isinstance(row, dict):
                        raise Blocked("BATCH_QUOTE_ROW_INVALID")
                    quote = row.get("quote")
                    if quote is None:
                        continue
                    if not isinstance(quote, dict):
                        raise Blocked("BATCH_QUOTE_SHAPE_INVALID")
                    symbol = quote.get("symbol")
                    if symbol not in batch or symbol in by_symbol:
                        raise Blocked("BATCH_QUOTE_IDENTITY_INVALID")
                    by_symbol[symbol] = quote

            except Exception as error:
                for symbol in batch:
                    failures[symbol] = (
                        str(error) if isinstance(error, Blocked)
                        else "BATCH_QUOTE_READ_FAILED:" + type(error).__name__
                    )
                continue

            for symbol in batch:
                try:
                    quote = by_symbol.get(symbol)
                    if quote is None:
                        raise Blocked("QUOTE_NOT_UNIQUE")
                    bid = number(quote["bid_price"])
                    ask = number(quote["ask_price"])
                    if (
                        quote.get("has_traded") is not True
                        or quote.get("state") != "active"
                        or not 0 < bid <= ask
                    ):
                        raise Blocked("INVALID_QUOTE")
                    if any(
                        not -2 <= age(quote[key]) <= 10
                        for key in ("venue_bid_time", "venue_ask_time")
                    ):
                        raise Blocked("STALE_QUOTE")
                    quotes[symbol] = (bid, ask)
                    observed_at[symbol] = time.time()
                    venue_times[symbol] = (
                        quote["venue_bid_time"], quote["venue_ask_time"]
                    )
                except Exception as error:
                    failures[symbol] = (
                        str(error) if isinstance(error, Blocked)
                        else "QUOTE_OR_HISTORY_FAILED:" + type(error).__name__
                    )

        # SI_HELD_QUOTE_REFRESH_ALL_BATCHES_V3
        # Refresh stale owned positions in all schema-bounded batches.
        # No sleeps, stale-price fallback, or concurrent quote requests.
        held_for_retry, _ = owned_book(self.db)
        stale_held = sorted(
            s for s in held_for_retry
            if failures.get(s) == "STALE_QUOTE"
        )

        for offset in range(0, len(stale_held), batch_size):
            retry_batch = stale_held[offset:offset + batch_size]
            try:
                refreshed = await asyncio.wait_for(
                    self.broker.call(
                        "get_equity_quotes", {"symbols": retry_batch}
                    ),
                    timeout=5,
                )
                retry_rows = refreshed.get("results")
                if not isinstance(retry_rows, list):
                    raise Blocked("RETRY_RESULTS_INVALID")

                retry_quotes = {}
                for row in retry_rows:
                    if not isinstance(row, dict):
                        raise Blocked("RETRY_ROW_INVALID")
                    q = row.get("quote")
                    if q is None:
                        continue
                    if not isinstance(q, dict):
                        raise Blocked("RETRY_QUOTE_SHAPE_INVALID")
                    symbol = q.get("symbol")
                    if symbol not in retry_batch or symbol in retry_quotes:
                        raise Blocked("RETRY_QUOTE_IDENTITY_INVALID")
                    retry_quotes[symbol] = q

            except Exception as error:
                for symbol in retry_batch:
                    failures[symbol] = (
                        "STALE_QUOTE;REFRESH_FAILED:"
                        + type(error).__name__
                    )
                continue

            for symbol in retry_batch:
                q = retry_quotes.get(symbol)
                if q is None:
                    failures[symbol] = "STALE_QUOTE;REFRESH_QUOTE_MISSING"
                    continue
                try:
                    bid = number(q["bid_price"])
                    ask = number(q["ask_price"])

                    if (
                        q.get("has_traded") is not True
                        or q.get("state") != "active"
                        or not 0 < bid <= ask
                    ):
                        raise Blocked("REFRESH_INVALID_QUOTE")

                    ages = [
                        age(q[k])
                        for k in ("venue_bid_time", "venue_ask_time")
                    ]
                    if any(not -2 <= value <= 10 for value in ages):
                        raise Blocked(
                            "STALE_QUOTE;REFRESH_BID_AGE="
                            + str(round(ages[0], 3))
                            + ";ASK_AGE="
                            + str(round(ages[1], 3))
                        )

                    quotes[symbol] = (bid, ask)
                    observed_at[symbol] = time.time()
                    venue_times[symbol] = (
                        q["venue_bid_time"], q["venue_ask_time"]
                    )
                    failures.pop(symbol, None)

                except Exception as error:
                    failures[symbol] = (
                        str(error) if isinstance(error, Blocked)
                        else "REFRESH_INVALID:" + type(error).__name__
                    )

        # Recheck every accepted quote after the additional read.
        for s in list(quotes):
            try:
                ages = [age(value) for value in venue_times[s]]
                if any(not -2 <= value <= 10 for value in ages):
                    raise Blocked(
                        "STALE_QUOTE;FINAL_BID_AGE=" + str(round(ages[0], 3))
                        + ";ASK_AGE=" + str(round(ages[1], 3))
                    )
            except Exception as error:
                quotes.pop(s, None)
                observed_at.pop(s, None)
                failures[s] = (str(error) if isinstance(error, Blocked)
                               else "FINAL_QUOTE_INVALID:" + type(error).__name__)

        if quotes:
            if self.db.in_transaction:
                raise Blocked("BATCH_SAMPLE_TRANSACTION_ALREADY_OPEN")
            try:
                with self.db:
                    self.db.executemany(
                        "INSERT INTO samples VALUES(?,?,?)",
                        [
                            (
                                symbol,
                                observed_at[symbol],
                                str((bid + ask) / 2),
                            )
                            for symbol, (bid, ask) in quotes.items()
                        ],
                    )
                    self.db.execute(
                        "DELETE FROM samples WHERE t<?",
                        (time.time() - 3600,),
                    )
            except Exception as error:
                raise Blocked("BATCH_SAMPLE_PERSISTENCE_FAILED") from error

            for symbol in quotes:
                try:
                    rows = self.db.execute(
                        "SELECT * FROM samples WHERE symbol=? "
                        "ORDER BY t DESC LIMIT 60",
                        (symbol,),
                    ).fetchall()[::-1]
                    if len(rows) != 60 or any(
                        not 5 <= rows[i]["t"] - rows[i-1]["t"] <= 25
                        for i in range(1, 60)
                    ):
                        scores[symbol] = None
                    else:
                        scores[symbol] = score([r["price"] for r in rows])
                except Exception as error:
                    failures[symbol] = (
                        str(error) if isinstance(error, Blocked)
                        else "QUOTE_OR_HISTORY_FAILED:" + type(error).__name__
                    )

        return quotes, scores, failures


