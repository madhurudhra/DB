#!/usr/bin/env python3
import csv
import json
import os
from datetime import datetime, timezone
from pathlib import Path

SOURCES = {
    "stocks": Path("/var/lib/stock-bot/stock_account.json"),
    "zerodha": Path("/opt/zerodha-bot/state/live_reconciliation_latest.json"),
}

def read_json(path):
    try:
        stat = path.stat()
        with path.open() as f:
            data = json.load(f)
        return {
            "available": True,
            "source_modified": datetime.fromtimestamp(
                stat.st_mtime, timezone.utc
            ).isoformat(),
            "data": data,
        }
    except (OSError, ValueError) as exc:
        return {"available": False, "error": type(exc).__name__}

def read_csv(path):
    try:
        stat = path.stat()
        with path.open(newline="") as f:
            rows = list(csv.DictReader(f))
        return {
            "available": True,
            "source_modified": datetime.fromtimestamp(
                stat.st_mtime, timezone.utc
            ).isoformat(),
            "rows": rows,
        }
    except OSError as exc:
        return {"available": False, "error": type(exc).__name__}

def main():
    result = {
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "crypto": {"available": False, "error": "Legacy snapshot retired; live crypto integration pending"},
        "stocks": read_json(SOURCES["stocks"]),
        "zerodha": read_json(SOURCES["zerodha"]),
    }

    result["crypto_trades"] = {
        "available": False,
        "error": "Legacy crypto history retired; live integration pending",
    }
    result["stock_trades"] = read_csv(
        Path("/var/lib/stock-bot/stock_trades.csv")
    )

    z = result["zerodha"]
    if z.get("available"):
        d = z["data"]
        result["zerodha_snapshot_is_paper"] = (
            d.get("mode") == "PAPER"
            or d.get("paper") is not None
            or d.get("read_only") is True
        )
        result["zerodha_snapshot_timestamp"] = d.get("timestamp_ist")

    print(json.dumps(result, separators=(",", ":")))

if __name__ == "__main__":
    main()

