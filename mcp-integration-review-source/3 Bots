import hashlib
import json
import os
import sqlite3
import sys
import uuid
from datetime import datetime, timezone
from decimal import Decimal

from rh_equity_review import call

DB = os.getenv(
    "DATABASE_PATH",
    "/var/lib/super-intelligence/super-intelligence.db",
)

def canonical(value):
    return json.dumps(value, sort_keys=<REDACTED>

def positive(value):
    number = Decimal(str(value))
    if not number.is_finite() or number <= 0:
        raise ValueError("Amounts and prices must be finite and positive")
    return number

def contains_error(value):
    if isinstance(value, dict):
        for key, item in value.items():
            if key in ("error", "errors", "validation_errors") and item:
                return True
            if contains_error(item):
                return True
    elif isinstance(value, list):
        return any(contains_error(item) for item in value)
    return False

async def mcp(tool, arguments):
    raw = await call(tool, arguments)
    result = json.loads(raw)
    if contains_error(result):
        raise RuntimeError(
            "Broker response contains an error. No automatic retry."
        )
    return result

def connection():
    db = sqlite3.connect(DB, timeout=10)
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA busy_timeout=10000")
    db.execute("""
        CREATE TABLE IF NOT EXISTS manual_execution_requests (
            request_id TEXT PRIMARY KEY,
            bot TEXT NOT NULL,
            payload_json TEXT NOT NULL,
            status TEXT NOT NULL,
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL,
            response_json TEXT,
            error_type TEXT
        )
    """)
    db.commit()
    return db

def register(request_id, bot, order):
    with connection() as db:
        db.execute("BEGIN IMMEDIATE")
        existing = db.execute(
            "SELECT bot,payload_json,status FROM manual_execution_requests "
            "WHERE request_id=?", (request_id,)
        ).fetchone()
        if existing:
            raise RuntimeError(
                "Request ID already recorded with status "
                + existing["status"]
                + ". Reconcile it; do not generate a replacement blindly."
            )
        unresolved = db.execute(
            "SELECT COUNT(*) FROM manual_execution_requests "
            "WHERE bot=? AND status IN ('SUBMITTING','UNKNOWN')",
            (bot,),
        ).fetchone()[0]
        if unresolved:
            raise RuntimeError(
                "This bot has an unresolved manual submission. "
                "Reconcile before another order."
            )
        now = datetime.now(timezone.utc).isoformat()
        db.execute(
            "INSERT INTO manual_execution_requests "
            "(request_id,bot,payload_json,status,created_at,updated_at) "
            "VALUES (?,?,?,?,?,?)",
            (
                request_id, bot, canonical(order),
                "SUBMITTING", now, now,
            ),
        )

def finish(request_id, status, response=None, error_type=None):
    with connection() as db:
        db.execute(
            "UPDATE manual_execution_requests SET "
            "status=?,updated_at=?,response_json=?,error_type=? "
            "WHERE request_id=?",
            (
                status,
                datetime.now(timezone.utc).isoformat(),
                json.dumps(response) if response is not None else None,
                error_type,
                request_id,
            ),
        )

