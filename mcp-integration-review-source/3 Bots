class Changes(BaseModel):
    model_config = ConfigDict(extra="forbid")
    buy_enabled: StrictBool | None = None
    sell_enabled: StrictBool | None = None
    bot_enabled: StrictBool | None = None

class ControlRequest(BaseModel):
    model_config = ConfigDict(extra="forbid")
    request_id: str = Field(min_length=8, max_length=200)
    expected_revision: int = Field(ge=0)
    bots: list[Literal["crypto", "equity", "zerodha"]] = Field(
        min_length=1, max_length=3
    )
    changes: Changes

def initialize(db):
    db.execute(
        "CREATE TABLE IF NOT EXISTS dashboard_control_state ("
        "singleton INTEGER PRIMARY KEY CHECK(singleton=1), "
        "revision INTEGER NOT NULL, state_json TEXT NOT NULL)"
    )
    db.execute(
        "CREATE TABLE IF NOT EXISTS dashboard_control_requests ("
        "request_id TEXT PRIMARY KEY, payload_json TEXT NOT NULL, "
        "response_json TEXT NOT NULL)"
    )
    initial = {
        bot: {
            "buy_enabled": None,
            "sell_enabled": None,
            "bot_enabled": None,
        }
        for bot in BOT_IDS
    }
    db.execute(
        "INSERT OR IGNORE INTO dashboard_control_state "
        "(singleton,revision,state_json) VALUES (1,0,?)",
        (json.dumps(initial),),
    )

def snapshot(db):
    row = db.execute(
        "SELECT revision,state_json FROM dashboard_control_state "
        "WHERE singleton=1"
    ).fetchone()
    return {
        "revision": row["revision"],
        "requested": json.loads(row["state_json"]),
        "effective": None,
        "enforcement_connected": False,
        "status": "SAVED_REQUESTS_ONLY",
        "warning": (
            "These settings do not control the current runner. "
            "No broker orders are submitted or canceled by this API."
        ),
    }

