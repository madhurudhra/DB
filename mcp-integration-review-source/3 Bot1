def route_map(routes):
    found = {}
    for route in routes:
        path = getattr(route, 'path', None)
        if not isinstance(path, str) or not (path.startswith('/api/') or path == '/health'):
            continue
        found.setdefault(path, set()).update(getattr(route, 'methods', set()) or set())
    return found

def catalog_data(routes):
    found = route_map(routes)
    features = []
    for feature in FEATURES:
        row = dict(feature)
        actual = found.get(row['path'], set())
        row['registered_methods'] = sorted(actual)
        row['registered'] = set(row['methods']) <= actual
        features.append(row)
    return {'generated_at': datetime.now(timezone.utc).isoformat(), 'features': features, 'registered_routes': [{'path': p, 'methods': sorted(methods)} for p, methods in sorted(found.items())], 'warning': 'Registration and HTTP success do not certify execution enforcement, data completeness, or trading permission.', 'automatic_trading_activated': False}

def catalog_effective_routes(application):
    from types import SimpleNamespace
    schema = application.openapi()
    paths = schema.get('paths') if isinstance(schema, dict) else None
    if not isinstance(paths, dict):
        raise ValueError('OpenAPI paths unavailable')
    allowed = {'get', 'post', 'put', 'patch', 'delete', 'head', 'options', 'trace'}
    routes = []
    for path, operations in paths.items():
        if not isinstance(path, str) or not isinstance(operations, dict):
            continue
        if not (path.startswith('/api/') or path == '/health'):
            continue
        methods = {method.upper() for method in operations if method in allowed}
        if methods:
            routes.append(SimpleNamespace(path=path, methods=methods))
    if not routes:
        raise ValueError('Empty effective API catalog')
    return routes

