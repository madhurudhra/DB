        g = (num(ann[0]["revenue"]) / num(ann[1]["revenue"]) - 1) * 100
        if g >= R["g_strong"]:
            add(2, "revenue growth %.0f%% YoY (strong)" % g)
        elif g >= R["g_ok"]:
            add(1, "revenue growth %.0f%% YoY" % g)
        elif g < 0:
            add(-2, "revenue shrinking %.0f%% YoY" % g)
            flags.append("revenue shrinking")
        else:
            add(0, "revenue growth %.0f%% YoY (weak)" % g)
    else:
        notes.append(" n/a  revenue growth (no data)")

    if len(qrows) >= 2 and num(qrows[0].get("revenue")) is not None and num(qrows[1].get("revenue")):
        qg = (num(qrows[0]["revenue"]) / num(qrows[1]["revenue"]) - 1) * 100
        add(1 if qg > 0 else -1, "latest quarter revenue %+.0f%% vs prior quarter" % qg)

    nm = num(ann[0].get("net_margin")) if ann else None
    if nm is not None:
        if nm > 0:
            add(2, "profitable (net margin %.0f%%)" % nm)
        elif nm < -100:
            add(-1, "net margin %.0f%% (deep losses vs revenue)" % nm)
            flags.append("deep net losses relative to revenue")
        else:
            add(0, "net margin %.0f%% (loss-making)" % nm)
    for q in qrows[:2]:
        ni, rv = num(q.get("net_income")), num(q.get("revenue"))
        if ni is not None and rv and abs(ni) > 5 * rv:
            flags.append("net income swings far larger than revenue (check non-operating items)")
            break

    mc = num(fund.get("market_cap"))
    qrev = [num(q.get("revenue")) for q in qrows[:4]]
    if len(qrev) == 4 and all(v is not None for v in qrev):
        ttm = sum(qrev)
    else:
        ttm = num(ann[0].get("revenue")) if ann else None
    if mc and ttm:
        ps = mc / ttm
        if ps < R["ps_cheap"]:
            add(2, "price/sales %.1fx (low)" % ps)
        elif ps < R["ps_ok"]:
            add(1, "price/sales %.1fx" % ps)
        elif ps < R["ps_rich"]:
            add(0, "price/sales %.1fx (rich)" % ps)
        else:
            add(-2, "price/sales %.0fx (very rich)" % ps)
            flags.append("valuation %.0fx sales" % ps)
    pe, pb = num(fund.get("pe_ratio")), num(fund.get("pb_ratio"))
    if pe is not None:
        if pe < 0:
            notes.append(" n/a  no earnings-based valuation (P/E negative)")
        elif pe < R["pe_cheap"]:
            add(1, "P/E %.1f" % pe)
        elif pe > R["pe_rich"]:
            add(-1, "P/E %.1f (high)" % pe)
    if pb is not None and pb > R["pb_rich"]:
        add(-1, "price/book %.1f (high)" % pb)

    er = (d.get("earnings") or {}).get("results") or []
    rep = [e for e in er if (e.get("eps") or {}).get("actual") is not None][-4:]
    if rep:
        beats = 0
        for e in rep:
            a, s = num(e["eps"]["actual"]), num(e["eps"].get("estimate"))
            if a is not None and s is not None and a > s:
                beats += 1
        add(2 if beats == len(rep) else 1 if beats >= len(rep) - 1 else -1,
            "beat EPS estimates in %d of last %d quarters" % (beats, len(rep)))
    for e in er:
        if (e.get("eps") or {}).get("actual") is None:
            try:
                days = (date.fromisoformat(e["report"]["date"]) - date.today()).days
            except Exception:
                continue
            if 0 <= days <= R["earn_days"]:
                add(-1, "earnings report in %d days (event risk)" % days)
                flags.append("earnings within %d days" % days)
            else:
                notes.append("  0  next earnings in %d days" % days)
            break

    rt = (first(d.get("ratings")) or {}).get("ratings") or {}
    b, h, s_ = [int(rt.get(k) or 0) for k in ("num_buy_ratings", "num_hold_ratings", "num_sell_ratings")]
    if b + h + s_:
        if b / (b + h + s_) >= 0.7:
            add(1, "analysts: %d buy / %d hold / %d sell" % (b, h, s_))
        elif s_ > b:
            add(-2, "analysts: %d buy / %d hold / %d sell" % (b, h, s_))
        else:
            add(0, "analysts: %d buy / %d hold / %d sell" % (b, h, s_))
        if rt.get("mean_price_target"):
            notes.append("  info  mean analyst target %s (not scored)" % rt["mean_price_target"])

    price = num(find_key(d.get("quote"), "last_trade_price"))
    hi, lo = num(fund.get("high_52_weeks")), num(fund.get("low_52_weeks"))
    if price and hi and lo and hi > lo:
        pos = float((price - lo) / (hi - lo))
        if pos < 0.15:
            add(-1, "price %.0f%% up the 52-week range (near lows, falling-knife risk)" % (pos * 100))
        elif pos < 0.6:
            add(1, "price %.0f%% up the 52-week range" % (pos * 100))
        elif pos < 0.9:
            add(0, "price %.0f%% up the 52-week range" % (pos * 100))
        else:
            add(-1, "price %.0f%% up the 52-week range (near highs)" % (pos * 100))

    if news.get("count"):
        add(-2 if news["label"] == "NEGATIVE" else 1 if news["label"] == "POSITIVE" else 0,
            "news %s (%d headlines, avg %.2f)" % (news["label"], news["count"], news["avg_score"]))
        if news.get("severe_negative"):
            flags.append("severe negative headline(s)")

    decision = ("ENTRY_CANDIDATE" if pts >= R["buy"] and not flags
                else "WATCH" if pts >= R["watch"] else "AVOID")
    return {"symbol": sym, "score": pts, "decision": decision, "notes": notes, "flags": flags,
            "unchecked": ["debt", "cash flow"], "errors": d.get("errors", {})}


def show(r):
    print("\n==== %s: %s (score %d) ====" % (r["symbol"], r["decision"], r["score"]))
    for n in r["notes"]:
        print("  " + n)
    for f in r["flags"]:
        print("  FLAG:", f)
    print("  NOT CHECKED:", ", ".join(r["unchecked"]), "| data errors:", r["errors"] or "none")


def save(r):
    try:
        c = sqlite3.connect(DB, timeout=10)
        c.execute("CREATE TABLE IF NOT EXISTS engine_decisions (id INTEGER PRIMARY KEY AUTOINCREMENT, "
                  "symbol TEXT NOT NULL, decided_at TEXT NOT NULL DEFAULT "
                  "(strftime('%Y-%m-%dT%H:%M:%fZ','now')), score INTEGER, decision TEXT, details_json TEXT)")
        c.execute("INSERT INTO engine_decisions (symbol,score,decision,details_json) VALUES (?,?,?,?)",
                  (r["symbol"], r["score"], r["decision"], json.dumps(r)))
        c.commit()
        c.close()
    except Exception as exc:
        print("  (decision not saved:", exc, ")")


async def main():
    syms = [s.upper() for s in sys.argv[1:]] or ["IONQ"]
    out = []
    for s in syms:
        d = await fetch(s)
        r = analyse(s, d, get_news(s))
        show(r)
        save(r)
        out.append(r)
    if len(out) > 1:
        print("\n---- side by side ----")
        for r in sorted(out, key=lambda x: -x["score"]):
            print("%-8s %-16s score %3d  flags %d" % (r["symbol"], r["decision"], r["score"], len(r["flags"])))


if __name__ == "__main__":
    asyncio.run(main())

